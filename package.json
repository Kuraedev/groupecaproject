{
  "name": "digital-twin-nextjs",
  "version": "1.0.0",
  "description": "AI-powered digital twin chat interface",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "build:portfolio": "npm --prefix portfolio run build && node scripts/sync-portfolio.mjs",
