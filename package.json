    "db:init": "node scripts/init-db.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "autoprefixer": "^10.4.19",
    "next": "^14.2.3",
    "pg": "^8.20.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.3"
  }
}
